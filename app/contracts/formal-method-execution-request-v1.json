{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sunmoonai.com/knowlab/formal-method/v1/execution-request.schema.json",
  "$defs": {
    "AccessRequirement": {
      "additionalProperties": false,
      "description": "Business permission, independent of installation IDs and tool names.\n\nFirst supported scope: connector operations with exact resource sets and\ntop-level outbound argument fields. Unsupported expressions are rejected.\nThis declaration is a ceiling, not authorization by the account owner.",
      "properties": {
        "requirement_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "capability_ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Capability Ref",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "operations": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResourceScope"
          },
          "maxItems": 30,
          "title": "Resources",
          "type": "array"
        },
        "data_transfer": {
          "$ref": "#/$defs/DataTransfer"
        },
        "required_when": {
          "const": "always",
          "default": "always",
          "title": "Required When",
          "type": "string"
        },
        "on_unavailable": {
          "const": "pause",
          "default": "pause",
          "title": "On Unavailable",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "capability_ref",
        "version",
        "operations",
        "resources",
        "data_transfer"
      ],
      "title": "AccessRequirement",
      "type": "object"
    },
    "ApprovalRule": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "operations": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "when": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "When",
          "type": "string"
        },
        "preview": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Preview",
          "type": "array"
        },
        "on_denied": {
          "enum": [
            "pause",
            "fail"
          ],
          "title": "On Denied",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "operations",
        "when",
        "preview",
        "on_denied"
      ],
      "title": "ApprovalRule",
      "type": "object"
    },
    "ApproxAssertion": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "approx",
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "maxLength": 512,
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "absolute_tolerance": {
          "minimum": 0,
          "title": "Absolute Tolerance",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "pointer",
        "value",
        "absolute_tolerance"
      ],
      "title": "ApproxAssertion",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "pattern": "^[0-9]{1,6}(\\.[0-9]{1,2})?$",
          "title": "Limit",
          "type": "string"
        },
        "currency": {
          "const": "CNY",
          "default": "CNY",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "limit"
      ],
      "title": "Budget",
      "type": "object"
    },
    "CallerValue": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "caller",
          "title": "Source",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "source",
        "name"
      ],
      "title": "CallerValue",
      "type": "object"
    },
    "CandidateCase": {
      "additionalProperties": false,
      "properties": {
        "equals": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Equals",
          "type": "string"
        },
        "candidate": {
          "$ref": "#/$defs/MethodRef"
        }
      },
      "required": [
        "equals",
        "candidate"
      ],
      "title": "CandidateCase",
      "type": "object"
    },
    "CandidateChoice": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Input",
          "type": "string"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/CandidateCase"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Cases",
          "type": "array"
        }
      },
      "required": [
        "input",
        "cases"
      ],
      "title": "CandidateChoice",
      "type": "object"
    },
    "CapabilityDeclaration": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "purpose": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Purpose",
          "type": "string"
        },
        "applies_when": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Applies When",
          "type": "array"
        },
        "excludes": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Excludes",
          "type": "array"
        },
        "promises": {
          "maxProperties": 30,
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
              "maxLength": 20000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            }
          },
          "title": "Promises",
          "type": "object"
        },
        "conditions": {
          "maxProperties": 30,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
              "$ref": "#/$defs/PromiseCondition"
            }
          },
          "title": "Conditions",
          "type": "object"
        }
      },
      "required": [
        "title",
        "purpose",
        "applies_when",
        "excludes",
        "promises"
      ],
      "title": "CapabilityDeclaration",
      "type": "object"
    },
    "CollaborationStep": {
      "additionalProperties": false,
      "properties": {
        "comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewComparison"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review_requirements": {
          "additionalProperties": false,
          "maxProperties": 100,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
              "enum": [
                "isolated_reviewer",
                "different_model_family"
              ],
              "type": "string"
            }
          },
          "title": "Review Requirements",
          "type": "object"
        },
        "isolation_group": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isolation Group"
        },
        "handoff_from": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Handoff From",
          "type": "array"
        }
      },
      "title": "CollaborationStep",
      "type": "object"
    },
    "ContainsAssertion": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "contains",
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "maxLength": 512,
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "value": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "pointer",
        "value"
      ],
      "title": "ContainsAssertion",
      "type": "object"
    },
    "DataTransfer": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Destination",
          "type": "string"
        },
        "argument_fields": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Argument Fields",
          "type": "array"
        },
        "purpose": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "destination",
        "argument_fields",
        "purpose"
      ],
      "title": "DataTransfer",
      "type": "object"
    },
    "EqualsAssertion": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "equals",
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "maxLength": 512,
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "kind",
        "pointer",
        "value"
      ],
      "title": "EqualsAssertion",
      "type": "object"
    },
    "Export": {
      "additionalProperties": false,
      "properties": {
        "step": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Step",
          "type": "string"
        },
        "output": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Output",
          "type": "string"
        },
        "always_present": {
          "title": "Always Present",
          "type": "boolean"
        }
      },
      "required": [
        "step",
        "output",
        "always_present"
      ],
      "title": "Export",
      "type": "object"
    },
    "FormalCaseExpectation": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "succeeded",
            "rejected"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "rejection_code": {
          "anyOf": [
            {
              "enum": [
                "authorization_denied",
                "approval_denied",
                "input_invalid"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejection Code"
        },
        "assertions": {
          "items": {
            "discriminator": {
              "mapping": {
                "approx": "#/$defs/ApproxAssertion",
                "contains": "#/$defs/ContainsAssertion",
                "equals": "#/$defs/EqualsAssertion"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/EqualsAssertion"
              },
              {
                "$ref": "#/$defs/ApproxAssertion"
              },
              {
                "$ref": "#/$defs/ContainsAssertion"
              }
            ]
          },
          "maxItems": 64,
          "title": "Assertions",
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "assertions"
      ],
      "title": "FormalCaseExpectation",
      "type": "object"
    },
    "FormalCaseInput": {
      "additionalProperties": false,
      "properties": {
        "values": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxProperties": 100,
          "title": "Values",
          "type": "object"
        },
        "model_prompt": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Prompt"
        }
      },
      "required": [
        "values"
      ],
      "title": "FormalCaseInput",
      "type": "object"
    },
    "FormalExecutionCase": {
      "additionalProperties": false,
      "properties": {
        "covers_promises": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Covers Promises",
          "type": "array"
        },
        "case_id": {
          "pattern": "^[A-Za-z0-9_-]{1,48}$",
          "title": "Case Id",
          "type": "string"
        },
        "caller": {
          "default": "host",
          "enum": [
            "host",
            "model"
          ],
          "title": "Caller",
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/FormalCaseInput"
        },
        "repetitions": {
          "maximum": 10,
          "minimum": 1,
          "title": "Repetitions",
          "type": "integer"
        },
        "minimum_passes": {
          "maximum": 10,
          "minimum": 1,
          "title": "Minimum Passes",
          "type": "integer"
        },
        "expected": {
          "$ref": "#/$defs/FormalCaseExpectation"
        }
      },
      "required": [
        "case_id",
        "input",
        "repetitions",
        "minimum_passes",
        "expected"
      ],
      "title": "FormalExecutionCase",
      "type": "object"
    },
    "FormalExecutionSpec": {
      "additionalProperties": false,
      "properties": {
        "suite": {
          "$ref": "#/$defs/FormalTestSuite"
        },
        "runner": {
          "$ref": "#/$defs/Runner"
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "timeout_seconds": {
          "maximum": 86400,
          "minimum": 60,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "max_wait_seconds": {
          "maximum": 604800,
          "minimum": 60,
          "title": "Max Wait Seconds",
          "type": "integer"
        },
        "model_probe": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelProbeLimits"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "suite",
        "runner",
        "budget",
        "timeout_seconds",
        "max_wait_seconds"
      ],
      "title": "FormalExecutionSpec",
      "type": "object"
    },
    "FormalMethodDefinition": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "knowlab/formal-method/v1",
          "title": "Contract",
          "type": "string"
        },
        "capability_declaration": {
          "$ref": "#/$defs/CapabilityDeclaration"
        },
        "access_requirements": {
          "items": {
            "$ref": "#/$defs/AccessRequirement"
          },
          "maxItems": 100,
          "title": "Access Requirements",
          "type": "array"
        },
        "procedure": {
          "discriminator": {
            "mapping": {
              "direct": "#/$defs/ToolProcedure",
              "orchestration": "#/$defs/Orchestration"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ToolProcedure"
            },
            {
              "$ref": "#/$defs/Orchestration"
            }
          ],
          "title": "Procedure"
        },
        "how_to_validate": {
          "items": {
            "$ref": "#/$defs/ValidationRule"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "How To Validate",
          "type": "array"
        },
        "what_requires_approval": {
          "items": {
            "$ref": "#/$defs/ApprovalRule"
          },
          "maxItems": 100,
          "title": "What Requires Approval",
          "type": "array"
        }
      },
      "required": [
        "contract",
        "capability_declaration",
        "access_requirements",
        "procedure",
        "how_to_validate",
        "what_requires_approval"
      ],
      "title": "FormalMethodDefinition",
      "type": "object"
    },
    "FormalMethodDraft": {
      "additionalProperties": false,
      "properties": {
        "definition": {
          "$ref": "#/$defs/FormalMethodDefinition"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormalMethodSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowed_callers": {
          "items": {
            "enum": [
              "host",
              "model"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Allowed Callers",
          "type": "array"
        }
      },
      "required": [
        "definition",
        "source",
        "allowed_callers"
      ],
      "title": "FormalMethodDraft",
      "type": "object"
    },
    "FormalMethodSource": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Asset Id"
        },
        "asset_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Asset Revision"
        },
        "kind": {
          "enum": [
            "platform",
            "mcp",
            "skill_instruction",
            "skill_script",
            "service_function",
            "registered_script",
            "registered_instruction"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        },
        "version": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "entry": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Entry",
          "type": "string"
        },
        "license_basis": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "License Basis",
          "type": "string"
        },
        "delivery_terms": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillDeliveryTerms"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "asset_id",
        "asset_revision",
        "kind",
        "source",
        "version",
        "digest",
        "entry",
        "license_basis"
      ],
      "title": "FormalMethodSource",
      "type": "object"
    },
    "FormalTestSuite": {
      "additionalProperties": false,
      "properties": {
        "suite_id": {
          "format": "uuid",
          "title": "Suite Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/FormalExecutionCase"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Cases",
          "type": "array"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "suite_id",
        "version",
        "cases",
        "digest"
      ],
      "title": "FormalTestSuite",
      "type": "object"
    },
    "ImplementationRef": {
      "additionalProperties": false,
      "description": "A portable source, never an author's credential or private connection ID.",
      "properties": {
        "kind": {
          "enum": [
            "platform",
            "mcp",
            "skill_instruction",
            "skill_script",
            "service_function",
            "registered_script",
            "registered_instruction"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        },
        "version": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "entry": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Entry",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Requirement Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "source",
        "version",
        "digest",
        "entry",
        "requirement_ids"
      ],
      "title": "ImplementationRef",
      "type": "object"
    },
    "JsonValue": {},
    "LiteralValue": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "literal",
          "title": "Source",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
