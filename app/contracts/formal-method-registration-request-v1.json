{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sunmoonai.com/knowlab/formal-method/v1/registration-request.schema.json",
  "$defs": {
    "AccessRequirement": {
      "additionalProperties": false,
      "description": "Business permission, independent of installation IDs and tool names.\n\nFirst supported scope: connector operations with exact resource sets and\ntop-level outbound argument fields. Unsupported expressions are rejected.\nThis declaration is a ceiling, not authorization by the account owner.",
      "properties": {
        "requirement_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "capability_ref": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Capability Ref",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "operations": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResourceScope"
          },
          "maxItems": 30,
          "title": "Resources",
          "type": "array"
        },
        "data_transfer": {
          "$ref": "#/$defs/DataTransfer"
        },
        "required_when": {
          "const": "always",
          "default": "always",
          "title": "Required When",
          "type": "string"
        },
        "on_unavailable": {
          "const": "pause",
          "default": "pause",
          "title": "On Unavailable",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "capability_ref",
        "version",
        "operations",
        "resources",
        "data_transfer"
      ],
      "title": "AccessRequirement",
      "type": "object"
    },
    "ApprovalRule": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Requirement Id",
          "type": "string"
        },
        "operations": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "when": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "When",
          "type": "string"
        },
        "preview": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Preview",
          "type": "array"
        },
        "on_denied": {
          "enum": [
            "pause",
            "fail"
          ],
          "title": "On Denied",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "operations",
        "when",
        "preview",
        "on_denied"
      ],
      "title": "ApprovalRule",
      "type": "object"
    },
    "CallerValue": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "caller",
          "title": "Source",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "source",
        "name"
      ],
      "title": "CallerValue",
      "type": "object"
    },
    "CandidateCase": {
      "additionalProperties": false,
      "properties": {
        "equals": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Equals",
          "type": "string"
        },
        "candidate": {
          "$ref": "#/$defs/MethodRef"
        }
      },
      "required": [
        "equals",
        "candidate"
      ],
      "title": "CandidateCase",
      "type": "object"
    },
    "CandidateChoice": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Input",
          "type": "string"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/CandidateCase"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Cases",
          "type": "array"
        }
      },
      "required": [
        "input",
        "cases"
      ],
      "title": "CandidateChoice",
      "type": "object"
    },
    "CapabilityDeclaration": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "purpose": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Purpose",
          "type": "string"
        },
        "applies_when": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Applies When",
          "type": "array"
        },
        "excludes": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Excludes",
          "type": "array"
        },
        "promises": {
          "maxProperties": 30,
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
              "maxLength": 20000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            }
          },
          "title": "Promises",
          "type": "object"
        },
        "conditions": {
          "maxProperties": 30,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
              "$ref": "#/$defs/PromiseCondition"
            }
          },
          "title": "Conditions",
          "type": "object"
        }
      },
      "required": [
        "title",
        "purpose",
        "applies_when",
        "excludes",
        "promises"
      ],
      "title": "CapabilityDeclaration",
      "type": "object"
    },
    "CollaborationStep": {
      "additionalProperties": false,
      "properties": {
        "comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewComparison"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review_requirements": {
          "maxProperties": 100,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
              "enum": [
                "isolated_reviewer",
                "different_model_family"
              ],
              "type": "string"
            }
          },
          "title": "Review Requirements",
          "type": "object"
        },
        "isolation_group": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isolation Group"
        },
        "handoff_from": {
          "default": [],
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Handoff From",
          "type": "array"
        }
      },
      "title": "CollaborationStep",
      "type": "object"
    },
    "DataTransfer": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Destination",
          "type": "string"
        },
        "argument_fields": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "title": "Argument Fields",
          "type": "array"
        },
        "purpose": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "destination",
        "argument_fields",
        "purpose"
      ],
      "title": "DataTransfer",
      "type": "object"
    },
    "Export": {
      "additionalProperties": false,
      "properties": {
        "step": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Step",
          "type": "string"
        },
        "output": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Output",
          "type": "string"
        },
        "always_present": {
          "title": "Always Present",
          "type": "boolean"
        }
      },
      "required": [
        "step",
        "output",
        "always_present"
      ],
      "title": "Export",
      "type": "object"
    },
    "FormalExecutionEvidenceRef": {
      "additionalProperties": false,
      "description": "Digest of the runtime's complete immutable minimal evidence package.\n\nIncludes original request identity, suite, actual task/attempt/call identity,\ngovernance facts and case outcomes. Secrets and credentials are excluded.\nA digest of an empty report or a client-provided check list is not evidence.",
      "properties": {
        "contract": {
          "const": "knowlab/formal-method-execution/v1",
          "title": "Contract",
          "type": "string"
        },
        "request_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "suite_id": {
          "format": "uuid",
          "title": "Suite Id",
          "type": "string"
        },
        "suite_version": {
          "minimum": 1,
          "title": "Suite Version",
          "type": "integer"
        },
        "suite_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Suite Digest",
          "type": "string"
        },
        "evidence_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "validated_callers": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "host",
                  "model"
                ],
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validated Callers"
        }
      },
      "required": [
        "contract",
        "request_digest",
        "suite_id",
        "suite_version",
        "suite_digest",
        "evidence_digest"
      ],
      "title": "FormalExecutionEvidenceRef",
      "type": "object"
    },
    "FormalMethodDefinition": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "knowlab/formal-method/v1",
          "title": "Contract",
          "type": "string"
        },
        "capability_declaration": {
          "$ref": "#/$defs/CapabilityDeclaration"
        },
        "access_requirements": {
          "items": {
            "$ref": "#/$defs/AccessRequirement"
          },
          "maxItems": 100,
          "title": "Access Requirements",
          "type": "array"
        },
        "procedure": {
          "discriminator": {
            "mapping": {
              "direct": "#/$defs/ToolProcedure",
              "orchestration": "#/$defs/Orchestration"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ToolProcedure"
            },
            {
              "$ref": "#/$defs/Orchestration"
            }
          ],
          "title": "Procedure"
        },
        "how_to_validate": {
          "items": {
            "$ref": "#/$defs/ValidationRule"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "How To Validate",
          "type": "array"
        },
        "what_requires_approval": {
          "items": {
            "$ref": "#/$defs/ApprovalRule"
          },
          "maxItems": 100,
          "title": "What Requires Approval",
          "type": "array"
        }
      },
      "required": [
        "contract",
        "capability_declaration",
        "access_requirements",
        "procedure",
        "how_to_validate",
        "what_requires_approval"
      ],
      "title": "FormalMethodDefinition",
      "type": "object"
    },
    "FormalMethodDraft": {
      "additionalProperties": false,
      "properties": {
        "definition": {
          "$ref": "#/$defs/FormalMethodDefinition"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormalMethodSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowed_callers": {
          "items": {
            "enum": [
              "host",
              "model"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Allowed Callers",
          "type": "array"
        }
      },
      "required": [
        "definition",
        "source",
        "allowed_callers"
      ],
      "title": "FormalMethodDraft",
      "type": "object"
    },
    "FormalMethodSource": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Asset Id"
        },
        "asset_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Asset Revision"
        },
        "kind": {
          "enum": [
            "platform",
            "mcp",
            "skill_instruction",
            "skill_script",
            "service_function",
            "registered_script",
            "registered_instruction"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        },
        "version": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "entry": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Entry",
          "type": "string"
        },
        "license_basis": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "License Basis",
          "type": "string"
        },
        "delivery_terms": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillDeliveryTerms"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "asset_id",
        "asset_revision",
        "kind",
        "source",
        "version",
        "digest",
        "entry",
        "license_basis"
      ],
      "title": "FormalMethodSource",
      "type": "object"
    },
    "FormalMethodValidationReceipt": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "knowlab/formal-method-validation/v1",
          "title": "Contract",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "owner_subject": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Owner Subject",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "workdraft_id": {
          "format": "uuid",
          "title": "Workdraft Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "method_id": {
          "format": "uuid",
          "title": "Method Id",
          "type": "string"
        },
        "definition_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Definition Digest",
          "type": "string"
        },
        "source_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Digest"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/MethodRef"
          },
          "maxItems": 1000,
          "title": "Dependencies",
          "type": "array"
        },
        "checks": {
          "items": {
            "enum": [
              "definition",
              "source",
              "dependencies",
              "authorization",
              "approval",
              "isolation",
              "outcome",
              "business"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "uncovered": {
          "items": {
            "$ref": "#/$defs/UncoveredScenario"
          },
          "maxItems": 30,
          "title": "Uncovered",
          "type": "array"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormalExecutionEvidenceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "contract",
        "run_id",
        "owner_subject",
        "request_id",
        "workdraft_id",
        "revision",
        "method_id",
        "definition_digest",
        "source_digest",
        "dependencies",
        "checks",
        "uncovered",
        "completed_at"
      ],
      "title": "FormalMethodValidationReceipt",
      "type": "object"
    },
    "ImplementationRef": {
      "additionalProperties": false,
      "description": "A portable source, never an author's credential or private connection ID.",
      "properties": {
        "kind": {
          "enum": [
            "platform",
            "mcp",
            "skill_instruction",
            "skill_script",
            "service_function",
            "registered_script",
            "registered_instruction"
          ],
          "title": "Kind",
          "type": "string"
        },
        "source": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        },
        "version": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "entry": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Entry",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Requirement Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "source",
        "version",
        "digest",
        "entry",
        "requirement_ids"
      ],
      "title": "ImplementationRef",
      "type": "object"
    },
    "LiteralValue": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "literal",
          "title": "Source",
          "type": "string"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "source",
        "value"
      ],
      "title": "LiteralValue",
      "type": "object"
    },
    "MethodRef": {
      "additionalProperties": false,
      "properties": {
        "method_id": {
          "format": "uuid",
          "title": "Method Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "method_id",
        "version",
        "digest"
      ],
      "title": "MethodRef",
      "type": "object"
    },
    "MethodStep": {
      "additionalProperties": false,
      "properties": {
        "candidate_choice": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateChoice"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/MethodRef"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        },
        "select_when": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Select When",
          "type": "string"
        },
        "required_when": {
          "maxLength": 20000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Required When",
          "type": "string"
        },
        "always_required": {
          "title": "Always Required",
          "type": "boolean"
        },
        "depends_on": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Depends On",
          "type": "array"
        },
        "inputs": {
          "maxProperties": 100,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
              "$ref": "#/$defs/StepInput"
            }
          },
          "title": "Inputs",
          "type": "object"
        },
        "outputs": {
          "maxProperties": 100,
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]{0,63}$": {
              "$ref": "#/$defs/ValueSlot"
            }
          },
          "title": "Outputs",
          "type": "object"
        },
        "on_failure": {
          "enum": [
            "pause",
            "fail"
          ],
          "title": "On Failure",
          "type": "string"
        }
      },
      "required": [
        "id",
        "candidates",
        "select_when",
        "required_when",
        "always_required",
        "depends_on",
        "inputs",
        "outputs",
        "on_failure"
      ],
      "title": "MethodStep",
      "type": "object"
    },
    "ObjectBatch": {
      "additionalProperties": false,
      "properties": {
        "max_objects": {
