      "maxItems": 4,
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "required_permissions": {
      "items": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,95}$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Required Permissions",
      "type": "array"
    },
    "input_schema": {
      "additionalProperties": true,
      "title": "Input Schema",
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": true,
      "title": "Output Schema",
      "type": "object"
    }
