{
  "requirements": {
    "$defs": {
      "McpRequirement": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "maxLength": 1000,
            "minLength": 8,
            "title": "Url",
            "type": "string"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "url",
          "name"
        ],
        "title": "McpRequirement",
        "type": "object"
      },
      "MethodToolBinding": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "maxLength": 1000,
            "minLength": 8,
            "title": "Url",
            "type": "string"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "requirement_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Requirement Id",
            "type": "string"
          }
        },
        "required": [
          "url",
          "name",
          "requirement_id"
        ],
        "title": "MethodToolBinding",
        "type": "object"
      },
      "SkillRequirement": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
            "title": "Name",
            "type": "string"
          },
          "version": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Version",
            "type": "string"
          },
          "digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Digest",
            "type": "string"
          },
          "required_tools": {
            "default": [],
            "items": {
              "$ref": "#/$defs/McpRequirement"
            },
            "maxItems": 30,
            "title": "Required Tools",
            "type": "array"
          }
        },
        "required": [
          "name",
          "version",
          "digest"
        ],
        "title": "SkillRequirement",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "tools": {
        "default": [],
        "items": {
          "$ref": "#/$defs/MethodToolBinding"
        },
        "maxItems": 30,
        "title": "Tools",
        "type": "array"
      },
      "skills": {
        "default": [],
        "items": {
          "$ref": "#/$defs/SkillRequirement"
        },
        "maxItems": 10,
        "title": "Skills",
        "type": "array"
      }
    },
    "title": "MethodCapabilities",
    "type": "object"
  },
  "access": {
    "$defs": {
      "AccessRequirement": {
        "additionalProperties": false,
        "description": "Business permission, independent of installation IDs and tool names.\n\nFirst supported scope: connector operations with exact resource sets and\ntop-level outbound argument fields. Unsupported expressions are rejected.\nThis declaration is a ceiling, not authorization by the account owner.",
        "properties": {
          "requirement_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Requirement Id",
            "type": "string"
          },
          "capability_ref": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Capability Ref",
            "type": "string"
          },
          "version": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Version",
            "type": "string"
          },
          "operations": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 30,
            "minItems": 1,
            "title": "Operations",
            "type": "array"
          },
          "resources": {
            "items": {
              "$ref": "#/$defs/ResourceScope"
            },
            "maxItems": 30,
            "title": "Resources",
            "type": "array"
          },
          "data_transfer": {
            "$ref": "#/$defs/DataTransfer"
          },
          "required_when": {
            "const": "always",
            "default": "always",
            "title": "Required When",
            "type": "string"
          },
          "on_unavailable": {
            "const": "pause",
            "default": "pause",
            "title": "On Unavailable",
            "type": "string"
          }
        },
        "required": [
          "requirement_id",
          "capability_ref",
          "version",
          "operations",
          "resources",
          "data_transfer"
        ],
        "title": "AccessRequirement",
        "type": "object"
      },
      "DataTransfer": {
        "additionalProperties": false,
        "properties": {
          "destination": {
            "maxLength": 1000,
            "minLength": 8,
            "title": "Destination",
            "type": "string"
          },
          "argument_fields": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 100,
            "title": "Argument Fields",
            "type": "array"
          },
          "purpose": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Purpose",
            "type": "string"
          }
        },
        "required": [
          "destination",
          "argument_fields",
          "purpose"
        ],
        "title": "DataTransfer",
        "type": "object"
      },
      "McpRequirement": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "maxLength": 1000,
            "minLength": 8,
            "title": "Url",
            "type": "string"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "url",
          "name"
        ],
        "title": "McpRequirement",
        "type": "object"
      },
      "MethodCapabilities": {
        "additionalProperties": false,
        "properties": {
          "tools": {
            "default": [],
            "items": {
              "$ref": "#/$defs/MethodToolBinding"
            },
            "maxItems": 30,
            "title": "Tools",
            "type": "array"
          },
          "skills": {
            "default": [],
            "items": {
              "$ref": "#/$defs/SkillRequirement"
            },
            "maxItems": 10,
            "title": "Skills",
            "type": "array"
          }
        },
        "title": "MethodCapabilities",
        "type": "object"
      },
      "MethodToolBinding": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "maxLength": 1000,
            "minLength": 8,
            "title": "Url",
            "type": "string"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "requirement_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Requirement Id",
            "type": "string"
          }
        },
        "required": [
          "url",
          "name",
          "requirement_id"
        ],
        "title": "MethodToolBinding",
        "type": "object"
      },
      "ResourceScope": {
        "additionalProperties": false,
        "properties": {
          "resource_kind": {
            "const": "connector",
            "default": "connector",
            "title": "Resource Kind",
            "type": "string"
          },
          "resource_role": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Resource Role",
            "type": "string"
          },
          "values": {
            "items": {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 1000,
            "minItems": 1,
            "title": "Values",
            "type": "array"
          }
        },
        "required": [
          "resource_role",
          "values"
        ],
        "title": "ResourceScope",
        "type": "object"
      },
      "SkillRequirement": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
            "title": "Name",
            "type": "string"
          },
          "version": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Version",
            "type": "string"
          },
          "digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Digest",
            "type": "string"
          },
          "required_tools": {
            "default": [],
            "items": {
              "$ref": "#/$defs/McpRequirement"
            },
            "maxItems": 30,
            "title": "Required Tools",
            "type": "array"
          }
        },
        "required": [
          "name",
          "version",
          "digest"
        ],
        "title": "SkillRequirement",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "access_requirements": {
        "default": [],
        "items": {
          "$ref": "#/$defs/AccessRequirement"
        },
        "maxItems": 30,
        "title": "Access Requirements",
        "type": "array"
      },
      "managed_capabilities": {
        "anyOf": [
          {
            "$ref": "#/$defs/MethodCapabilities"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "title": "MethodAccess",
    "type": "object"
  },
  "author_catalog": {
    "$defs": {
      "AuthorSkill": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
            "title": "Name",
            "type": "string"
          },
          "version": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Version",
            "type": "string"
          },
          "digest": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Digest",
            "type": "string"
          },
          "required_tools": {
            "default": [],
            "items": {
              "$ref": "#/$defs/McpRequirement"
            },
            "maxItems": 30,
            "title": "Required Tools",
            "type": "array"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "unresolved_dependencies": {
            "default": false,
            "title": "Unresolved Dependencies",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "version",
          "digest",
          "description"
        ],
        "title": "AuthorSkill",
        "type": "object"
      },
      "AuthorTool": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "maxLength": 1000,
            "minLength": 8,
            "title": "Url",
            "type": "string"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "service_name": {
            "title": "Service Name",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "url",
          "name",
          "service_name",
          "description"
        ],
        "title": "AuthorTool",
        "type": "object"
      },
      "McpRequirement": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "maxLength": 1000,
            "minLength": 8,
            "title": "Url",
            "type": "string"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "url",
          "name"
        ],
        "title": "McpRequirement",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "tools": {
        "items": {
          "$ref": "#/$defs/AuthorTool"
        },
        "title": "Tools",
        "type": "array"
      },
      "skills": {
        "items": {
          "$ref": "#/$defs/AuthorSkill"
        },
        "title": "Skills",
        "type": "array"
      }
    },
    "required": [
      "tools",
      "skills"
    ],
    "title": "AuthorCapabilityCatalog",
    "type": "object"
  }
}
